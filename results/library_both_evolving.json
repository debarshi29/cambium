        "name": "run_length_encoding_skill",
        "signature": "rle_encode(...)",
        "docstring": "Run-length encode a string as count+character pairs.",
        "source": "def rle_encode(s):\n    if not s:\n        return ''\n    out = []\n    cur, cnt = s[0], 1\n    for c in s[1:]:\n        if c == cur:\n            cnt += 1\n        else:\n            out.append(f'{cnt}{cur}')\n            cur, cnt = c, 1\n    out.append(f'{cnt}{cur}')\n    return ''.join(out)",
        "fn_name": "rle_encode",
