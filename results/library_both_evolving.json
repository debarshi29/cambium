        "signature": "caesar_encrypt(...)",
        "docstring": "Caesar-shift the lowercase letters of a string by a fixed offset.",
        "source": "def caesar_encrypt(s, shift):\n    shift = shift % 26\n    return ''.join(\n        chr((ord(c) - 97 + shift) % 26 + 97) if c.islower() else c\n        for c in s\n    )",
        "fn_name": "caesar_encrypt",
