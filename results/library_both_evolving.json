        "signature": "is_balanced(...)",
        "docstring": "Check that (), [] and {} brackets are properly nested and closed.",
        "source": "def is_balanced(s):\n    opens, closes = '([{', ')]}'\n    stack = []\n    for ch in s:\n        if ch in opens:\n            stack.append(ch)\n        elif ch in closes:\n            if not stack or stack.pop() != opens[closes.index(ch)]:\n                return False\n    return not stack",
