# Set ONE of these. If both are set, Groq wins unless LLM_PROVIDER says otherwise.

# Gemini API (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# optional, defaults to gemma-4-31b-it (any Gemini API model id works)
# GEMINI_MODEL=gemma-4-31b-it

# Groq: https://console.groq.com
# GROQ_API_KEY=your-groq-api-key-here
# optional, defaults to openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-20b

# optional overrides
# LLM_PROVIDER=gemini   # or groq
# LLM_MODEL=...         # overrides the provider-specific model variable
